NODE_ENV=development
PORT=3000

# dev ใช้ root เพราะ `prisma migrate dev` ต้องสร้าง shadow database ชั่วคราว
# production ใส่ URL ของ managed MySQL และต่อท้ายด้วย ?connection_limit=5
DATABASE_URL="mysql://root:devpassword@localhost:3306/tripnote"

# อย่างน้อย 32 ตัวอักษร production ต้องใช้ค่าคนละตัวกับ dev
# สร้างด้วย: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# ปล่อยว่างได้เมื่อ client เรียกผ่าน proxy/rewrite (same origin)
# ใส่เฉพาะเมื่อ client อยู่คนละ origin จริง ๆ คั่นหลายค่าด้วย ,
CORS_ORIGIN=
