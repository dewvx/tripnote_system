// แหล่งความจริงเดียวของโครงสร้างฐานข้อมูล คำอธิบายเชิงออกแบบอยู่ที่ docs/DATABASE.md
//
// วิธีอ่านสำหรับคนที่มาจาก SQL
//   model            = ตาราง (ชื่อตารางจริงอยู่ที่ @@map)
//   field Type       = คอลัมน์ (ชื่อคอลัมน์จริงอยู่ที่ @map), Type? = NULL ได้
//   @relation        = FOREIGN KEY
//   @@index/@@unique = INDEX / UNIQUE
//   field ที่ชนิดเป็น model อื่น (เช่น trip Trip) ไม่ใช่คอลัมน์ เป็นทางลัดสำหรับ JOIN ในโค้ด

generator client {
  provider      = "prisma-client-js"
  // native = เครื่อง dev, rhel-openssl-3.0.x = runtime ของ Vercel
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum TripStatus {
  planning
  active
  completed
  cancelled
}

enum MemberRole {
  owner
  editor
  viewer
}

enum PlaceCategory {
  attraction
  accommodation
  food
  event
  shopping
  transport_hub
  other
}

enum ItineraryItemType {
  activity
  transport
}

enum ItineraryItemStatus {
  planned
  done
  skipped
}

enum TransportMode {
  bus
  train
  car
  motorcycle
  taxi
  flight
  boat
  walk
  other
}

enum PhotoKind {
  memory
  receipt
}

// ---------- Account ----------

model User {
  id           Int      @id @default(autoincrement()) @db.UnsignedInt
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  displayName  String   @map("display_name") @db.VarChar(100)
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.DateTime(0)

  refreshTokens  RefreshToken[]
  memberships    TripMember[]
  tripsCreated   Trip[]
  expensesLogged Expense[]
  journalEntries JournalEntry[]
  photosUploaded Photo[]

  @@map("users")
}

model RefreshToken {
  id        Int       @id @default(autoincrement()) @db.UnsignedInt
  userId    Int       @map("user_id") @db.UnsignedInt
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.DateTime(0)
  revokedAt DateTime? @map("revoked_at") @db.DateTime(0)
  userAgent String?   @map("user_agent") @db.VarChar(255)
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ---------- Trip ----------

model Trip {
  id              Int        @id @default(autoincrement()) @db.UnsignedInt
  createdByUserId Int        @map("created_by_user_id") @db.UnsignedInt
  name            String     @db.VarChar(150)
  description     String?    @db.Text
  originName      String?    @map("origin_name") @db.VarChar(150)
  destinationName String     @map("destination_name") @db.VarChar(150)
  destinationLat  Decimal?   @map("destination_lat") @db.Decimal(9, 6)
  destinationLng  Decimal?   @map("destination_lng") @db.Decimal(9, 6)
  startDate       DateTime   @map("start_date") @db.Date
  endDate         DateTime   @map("end_date") @db.Date
  timezone        String     @default("Asia/Bangkok") @db.VarChar(64)
  currency        String     @default("THB") @db.Char(3)
  budgetAmount    Decimal?   @map("budget_amount") @db.Decimal(12, 2)
  status          TripStatus @default(planning)
  startedAt       DateTime?  @map("started_at") @db.DateTime(0)
  completedAt     DateTime?  @map("completed_at") @db.DateTime(0)
  createdAt       DateTime   @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.DateTime(0)
  deletedAt       DateTime?  @map("deleted_at") @db.DateTime(0)

  createdBy      User            @relation(fields: [createdByUserId], references: [id])
  members        TripMember[]
  places         Place[]
  itineraryItems ItineraryItem[]
  expenses       Expense[]
  journalEntries JournalEntry[]
  photos         Photo[]

  @@index([createdByUserId])
  @@map("trips")
}

model TripMember {
  id          Int        @id @default(autoincrement()) @db.UnsignedInt
  tripId      Int        @map("trip_id") @db.UnsignedInt
  // NULL = guest (คนร่วมทริปที่ไม่มีบัญชี)
  userId      Int?       @map("user_id") @db.UnsignedInt
  displayName String     @map("display_name") @db.VarChar(100)
  role        MemberRole @default(editor)
  createdAt   DateTime   @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.DateTime(0)

  trip         Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user         User?     @relation(fields: [userId], references: [id])
  expensesPaid Expense[]

  // MySQL ยอมให้ NULL ซ้ำใน unique index จึงมี guest ได้หลายคนต่อทริป
  @@unique([tripId, userId])
  @@index([userId])
  @@map("trip_members")
}

// ---------- Planning ----------

model Place {
  id             Int           @id @default(autoincrement()) @db.UnsignedInt
  tripId         Int           @map("trip_id") @db.UnsignedInt
  name           String        @db.VarChar(150)
  category       PlaceCategory @default(other)
  address        String?       @db.VarChar(255)
  lat            Decimal?      @db.Decimal(9, 6)
  lng            Decimal?      @db.Decimal(9, 6)
  externalSource String?       @map("external_source") @db.VarChar(30)
  externalId     String?       @map("external_id") @db.VarChar(255)
  note           String?       @db.Text
  createdAt      DateTime      @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.DateTime(0)

  trip           Trip            @relation(fields: [tripId], references: [id], onDelete: Cascade)
  itineraryItems ItineraryItem[]
  expenses       Expense[]
  journalEntries JournalEntry[]

  @@index([tripId])
  @@map("places")
}

model ItineraryItem {
  id            Int                 @id @default(autoincrement()) @db.UnsignedInt
  tripId        Int                 @map("trip_id") @db.UnsignedInt
  dayDate       DateTime            @map("day_date") @db.Date
  // TIME ใน Prisma อ่านออกมาเป็น DateTime ของวันที่ 1970-01-01 ให้ repository แปลงเป็น "HH:mm"
  startTime     DateTime?           @map("start_time") @db.Time(0)
  endTime       DateTime?           @map("end_time") @db.Time(0)
  type          ItineraryItemType   @default(activity)
  title         String              @db.VarChar(150)
  placeId       Int?                @map("place_id") @db.UnsignedInt
  transportMode TransportMode?      @map("transport_mode")
  fromLabel     String?             @map("from_label") @db.VarChar(150)
  toLabel       String?             @map("to_label") @db.VarChar(150)
  estimatedCost Decimal?            @map("estimated_cost") @db.Decimal(12, 2)
  note          String?             @db.Text
  status        ItineraryItemStatus @default(planned)
  sortOrder     Int                 @default(0) @map("sort_order")
  createdAt     DateTime            @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt     DateTime            @updatedAt @map("updated_at") @db.DateTime(0)

  trip  Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  place Place? @relation(fields: [placeId], references: [id], onDelete: SetNull)

  @@index([tripId, dayDate, sortOrder])
  @@index([placeId])
  @@map("itinerary_items")
}

// ---------- Expense ----------

model ExpenseCategory {
  id        Int     @id @default(autoincrement()) @db.UnsignedInt
  code      String  @unique @db.VarChar(30)
  nameTh    String  @map("name_th") @db.VarChar(50)
  nameEn    String  @map("name_en") @db.VarChar(50)
  icon      String  @db.VarChar(30)
  color     String  @db.Char(7)
  sortOrder Int     @default(0) @map("sort_order")
  isActive  Boolean @default(true) @map("is_active")

  expenses Expense[]

  @@map("expense_categories")
}

model Expense {
  id              Int       @id @default(autoincrement()) @db.UnsignedInt
  tripId          Int       @map("trip_id") @db.UnsignedInt
  categoryId      Int       @map("category_id") @db.UnsignedInt
  paidByMemberId  Int       @map("paid_by_member_id") @db.UnsignedInt
  createdByUserId Int       @map("created_by_user_id") @db.UnsignedInt
  amount          Decimal   @db.Decimal(12, 2)
  description     String?   @db.VarChar(255)
  spentAt         DateTime  @default(now()) @map("spent_at") @db.DateTime(0)
  placeId         Int?      @map("place_id") @db.UnsignedInt
  journalEntryId  Int?      @map("journal_entry_id") @db.UnsignedInt
  // UUID ที่ client สร้าง ใช้กันรายการซ้ำเมื่อกดบันทึกซ้ำตอนเน็ตหลุด
  clientId        String?   @map("client_id") @db.Char(36)
  createdAt       DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.DateTime(0)
  deletedAt       DateTime? @map("deleted_at") @db.DateTime(0)

  trip         Trip            @relation(fields: [tripId], references: [id], onDelete: Cascade)
  category     ExpenseCategory @relation(fields: [categoryId], references: [id])
  paidBy       TripMember      @relation(fields: [paidByMemberId], references: [id])
  createdBy    User            @relation(fields: [createdByUserId], references: [id])
  place        Place?          @relation(fields: [placeId], references: [id], onDelete: SetNull)
  journalEntry JournalEntry?   @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)
  photos       Photo[]

  @@unique([tripId, clientId])
  @@index([tripId, spentAt])
  @@index([tripId, categoryId])
  @@index([tripId, paidByMemberId])
  @@index([categoryId])
  @@index([paidByMemberId])
  @@index([placeId])
  @@index([journalEntryId])
  @@map("expenses")
}

// ---------- Journal ----------

model JournalEntry {
  id              Int       @id @default(autoincrement()) @db.UnsignedInt
  tripId          Int       @map("trip_id") @db.UnsignedInt
  createdByUserId Int       @map("created_by_user_id") @db.UnsignedInt
  body            String?   @db.Text
  placeId         Int?      @map("place_id") @db.UnsignedInt
  locationLabel   String?   @map("location_label") @db.VarChar(150)
  lat             Decimal?  @db.Decimal(9, 6)
  lng             Decimal?  @db.Decimal(9, 6)
  rating          Int?      @db.UnsignedTinyInt
  occurredAt      DateTime  @default(now()) @map("occurred_at") @db.DateTime(0)
  clientId        String?   @map("client_id") @db.Char(36)
  createdAt       DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.DateTime(0)
  deletedAt       DateTime? @map("deleted_at") @db.DateTime(0)

  trip      Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  createdBy User      @relation(fields: [createdByUserId], references: [id])
  place     Place?    @relation(fields: [placeId], references: [id], onDelete: SetNull)
  expenses  Expense[]
  photos    Photo[]

  @@unique([tripId, clientId])
  @@index([tripId, occurredAt])
  @@index([tripId, placeId])
  @@index([placeId])
  @@map("journal_entries")
}

model Photo {
  id               Int       @id @default(autoincrement()) @db.UnsignedInt
  tripId           Int       @map("trip_id") @db.UnsignedInt
  uploadedByUserId Int       @map("uploaded_by_user_id") @db.UnsignedInt
  kind             PhotoKind @default(memory)
  journalEntryId   Int?      @map("journal_entry_id") @db.UnsignedInt
  expenseId        Int?      @map("expense_id") @db.UnsignedInt
  storageKey       String    @map("storage_key") @db.VarChar(255)
  thumbKey         String    @map("thumb_key") @db.VarChar(255)
  mimeType         String    @map("mime_type") @db.VarChar(50)
  sizeBytes        Int       @map("size_bytes") @db.UnsignedInt
  width            Int       @db.UnsignedInt
  height           Int       @db.UnsignedInt
  caption          String?   @db.VarChar(255)
  takenAt          DateTime? @map("taken_at") @db.DateTime(0)
  createdAt        DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  deletedAt        DateTime? @map("deleted_at") @db.DateTime(0)

  trip         Trip          @relation(fields: [tripId], references: [id], onDelete: Cascade)
  uploadedBy   User          @relation(fields: [uploadedByUserId], references: [id])
  journalEntry JournalEntry? @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)
  expense      Expense?      @relation(fields: [expenseId], references: [id], onDelete: SetNull)

  @@index([tripId, takenAt])
  @@index([journalEntryId])
  @@index([expenseId])
  @@map("photos")
}
